{
  "name": "jaffa-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "dev:all": "concurrently \"npm run dev\" \"cd ../frontend && npm run dev\"",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:sync": "ts-node src/scripts/syncDb.ts",
    "db:repair-over-predictions": "ts-node src/scripts/repairOverPredictions.ts"
  },
  "dependencies": {
    "@types/nodemailer": "^7.0.11",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^8.0.4",
    "pg": "^8.16.0",
    "sequelize": "^6.37.7",
    "socket.io": "^4.8.3",
    "sqlite3": "^6.0.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.5.0",
    "@types/uuid": "^11.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
