PORT=3001
DATABASE_URL=postgres://user:password@localhost:5432/jaffa

# --- Secrets (REQUIRED — server refuses to boot without these) ---
# Use at least 32 random chars in production. e.g. `openssl rand -base64 48`
JWT_SECRET=your-super-secret-jwt-key-change-this
# Owner dashboard credentials — never default to admin/admin
OWNER_USER=change-me
OWNER_PASS=change-me-use-a-long-random-password

# --- Auth mode ---
# Leave unset (or =false) to require OTP login. Set to "true" ONLY in local dev
# while the frontend OTP flow is being wired — /auth/phone-login returns 410 otherwise.
# NEVER enable this in production; it mints a JWT for any phone number with zero verification.
ALLOW_UNSAFE_PHONE_LOGIN=false

# --- Services ---
OTP_SERVICE=mock
SPORTSMONK_API_KEY=your-sportsmonk-key
CRICKET_API_URL=https://api.cricapi.com/v1
CRICKET_API_KEY=your-cricket-api-key

# --- Geofence ---
# When true, the join endpoint rejects clients without GPS or outside the venue radius.
# Default (unset or false) is soft mode: the server warns but accepts the join — suitable
# for local dev / desktop testing. Flip to "true" before pilot.
STRICT_GEOFENCE=false

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGIN=http://localhost:3000
